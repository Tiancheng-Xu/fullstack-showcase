{
	"name": "baby2b-performance-control",
	"main": "src/index.ts",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-08-14",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"CONTROL_ENABLED": "false",
		"CONTROL_ORIGIN": "https://baby2b.online",
		"GITHUB_APP_ID": "replace-at-deploy-time",
		"GITHUB_APP_INSTALLATION_ID": "replace-at-deploy-time"
	},
	// Required Worker secrets (names only):
	// TOTP_SECRET
	// GITHUB_APP_PRIVATE_KEY
	// CALLBACK_HMAC_SECRET
	"d1_databases": [
		{
			"binding": "CONTROL_DB",
			"database_name": "baby2b-performance-control",
			"database_id": "replace-at-deploy-time",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "SNAPSHOTS",
			"bucket_name": "baby2b-performance-snapshots"
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	}
}
