		{
			"dot": "emerald",
			"title": "同步合同",
			"items": [
				"Webhook 必须校验签名、时间和 delivery ID",
				"projects.json 携带生成时间和来源新鲜度",
				"健康检查是 API JSON，不是需要视觉适配的 UI 页面"
			]
		},
		{
			"dot": "cyan",
			"title": "合并优先级",
			"items": [
				"人工核验的状态、进度、正式链接与 sourceUpdatedAt 优先",
				"远端数据可补充描述、仓库元数据和未知项目",
				"旧远端快照不得把已完成项目降级"
			]
		},
		{
			"dot": "rose",
			"title": "降级与证据",
			"items": [
				"SSR 和 JavaScript 失败时仍有静态基线",
				"HTTP 200 不等于语义正确，必须检查 payload 与页面内容",
				"同步 Evidence 不替代各项目自己的生产 Evidence"
