	"cards": [
		{
			"dot": "amber",
			"title": "当前边界",
			"items": [
				"这是共享能力设计，不自动把所有项目升级为 verified-production",
				"每个项目必须拥有独立 Run、commit、URL 与语义结果",
				"若共享验证器尚未实际部署，状态必须保持 pending"
			]
		},
		{
			"dot": "cyan",
			"title": "低成本策略",
			"items": [
				"优先非 VPC Lambda、短超时、短日志保留和复用安全 Artifact Bucket",
				"禁止为静态验证复制 VPC、NAT、RDS、ECS 或 API Gateway",
				"每项目一次短调用，调用前仍需实时预算与资格检查"
			]
		},
		{
			"dot": "rose",
			"title": "安全限制",
			"items": [
				"只允许固定公开 URL/manifest，不抓取私有仓库、模型权重或用户输入",
				"OIDC 角色按仓库和工作流最小授权",
				"任一权限或库存读回失败时 fail-closed，不把 AccessDenied 当作零残留"
			]
		}
	]
