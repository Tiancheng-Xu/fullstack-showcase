	"cards": [
		{
			"dot": "emerald",
			"title": "控制原则",
			"items": [
				"路径路由绑定明确 projectId",
				"前端按钮不是权限边界，服务端必须验证身份、nonce 与项目 allowlist",
				"状态未确认时保持 pending/blocked，禁止伪造 success"
			]
		},
		{
			"dot": "cyan",
			"title": "最小权限",
			"items": [
				"GitHub App 仅调度固定 workflow",
				"OIDC 只签发短期项目权限，不保存 AWS 长期密钥",
				"日志读取限制在项目日志组，不扩为 logs:*"
			]
		},
		{
			"dot": "rose",
			"title": "成本与恢复",
			"items": [
				"启动前执行 aws-budget-guard 与 Free-plan 资格检查",
				"TTL、精确 Stack 与资源标签共同限制生命周期",
				"清理未验证时禁止再次启动，只开放 stop/recovery"
			]
		}
	]
